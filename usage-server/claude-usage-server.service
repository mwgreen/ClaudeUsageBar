# systemd user unit for claude_usage_server.py. Install on the host that holds
# the Claude login (see README "Remote accounts"):
#
#   mkdir -p ~/.config/systemd/user
#   cp usage-server/claude-usage-server.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now claude-usage-server
#
# An SSH tunnel's session keeps user services running while it is connected.
# Only if the server must run with no session at all:
#   sudo loginctl enable-linger "$USER"
#
# ExecStart assumes the repo is cloned at ~/git-repos/ClaudeUsageBar; adjust if not.

[Unit]
Description=ClaudeUsageBar usage server (serves this host's Claude usage on 127.0.0.1:7103)

[Service]
# --keep-token-fresh lets the server run a tiny `claude -p` (Haiku) call when
# the stored token expires, so usage keeps flowing when claude isn't otherwise
# used here. Drop it to only report token_expired instead.
ExecStart=/usr/bin/python3 %h/git-repos/ClaudeUsageBar/usage-server/claude_usage_server.py --port 7103 --keep-token-fresh
# So the server can find `claude` (User-Agent version, --keep-token-fresh).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
